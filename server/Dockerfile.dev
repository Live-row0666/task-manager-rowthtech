FROM node:20

WORKDIR /app

# Copy package dependency manifests first for layer caching
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy application code
COPY . .

# Set development environment
ENV NODE_ENV=development
ENV PORT=9100

# Expose backend port
EXPOSE 9100

# Run server with live reload (nodemon)
CMD ["npm", "run", "dev"]
